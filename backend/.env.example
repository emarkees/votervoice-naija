# VoterVoice Naija - Backend Environment Variables
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Africa's Talking Telephony Configuration (Get free sandbox credentials at account.africastalking.com)
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_sandbox_api_key
AT_PHONE_NUMBER=+2347000000000
AT_USSD_CODE=*384*24#

# OpenAI / AI Speech & RAG Engine (Optional for mock mode; set for live Whisper/Embeddings)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Cache & Session Storage
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
